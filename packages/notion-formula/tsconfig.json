{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM", "ESNext.Disposable"],
    "strict": true,
    "declaration": true,
    "rootDir": "src",
